      "APIKeyCreate": {
        "description": "Request body for creating an API key via the public API.\n\n`scopes` must be a subset of the caller's own scopes. Omitting `project_id` (or\npassing `null`) mints an org-wide key; giving a `project_id` scopes the key to that\nproject. `claims` carries optional per-scope settings (today only\n`project:gateway_proxy`). Whether the new key is personal or a service key is\nderived from the caller, not chosen here.",
        "properties": {
          "claims": {
            "$ref": "#/components/schemas/ScopeClaims"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "project_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          },
          "scopes": {
            "examples": [
              [
                "organization:read_api_key"
              ]
            ],
            "items": {
              "$ref": "#/components/schemas/OAuthScopeId"
            },
            "minItems": 1,
            "title": "Scopes",
            "type": "array"
          }
        },
        "required": [
          "name",
          "scopes"
        ],
        "title": "APIKeyCreate",
        "type": "object"
      },
      "APIKeyCreateOutput": {
        "description": "The created key plus its plaintext token (returned only once, at creation).",
        "properties": {
          "api_key": {
            "$ref": "#/components/schemas/APIKeyRead"
          },
          "token": {
            "title": "Token",
            "type": "string"
          }
