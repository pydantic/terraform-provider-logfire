  "info": {
    "description": "To be able to use the Logfire API, you need to either create an\n[OAuth App](https://logfire.pydantic.dev/-/redirect/default-org/settings/developer/oauth-apps) or a\n[Personal Access Token](https://logfire.pydantic.dev/-/redirect/default-org/settings/developer/pat).\n",
    "summary": "Public API to access Logfire resources",
    "termsOfService": "https://pydantic.dev/legal/terms-of-service",
    "title": "Pydantic Logfire API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/api-keys/": {
      "get": {
        "description": "List the organization's API keys, including project-scoped keys.\n\nA non-personal (service) caller sees only service keys (`user_id IS NULL`). A\npersonal caller additionally sees its own personal keys; another user's personal\nkeys are always hidden, matching the ownership guard on update/delete.",
        "operationId": "list_organization_api_keys_v1_api_keys__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/APIKeyRead"
                  },
                  "title": "Response List Organization Api Keys V1 Api Keys  Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPExceptionError"
                }
              }
            },
            "description": "Rate limit exceeded",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2AuthorizationCodeBearer": [
              "organization:read_api_key"
            ]
          }
        ],
        "summary": "List Organization Api Keys",
        "tags": [
          "API Keys"
        ]
      },
      "post": {
        "description": "Create an API key delegated from the calling credential.\n\nThe new key can never exceed the caller's own grant: its scopes, personal/service\nkind, and project scope are all constrained to the caller. Creation is audit-logged\nby the service layer.\n\nOmitting `project_id` makes an organization-wide key. One may carry a project-bound\nscope (`project:gateway_proxy`, `project:read_otlp`, `project:write_otlp`) only\nalongside `organization:create_api_key`, and then only to pass on: it resolves no\nproject, so it can grant the scope to the project keys it creates but never use it.\nAny other pairing is rejected with 422.",
        "operationId": "create_organization_api_key_v1_api_keys__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/APIKeyCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIKeyCreateOutput"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "description": "Requested scopes or project scoping exceed the caller's own grant, or its owner lacks the permissions those scopes require on the target project"
          },
          "404": {
            "description": "Project not found. A caller whose own project authorization is checked gets the 403 above instead, which does not distinguish a project it cannot reach from one that does not exist"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPExceptionError"
                }
              }
            },
            "description": "Rate limit exceeded",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2AuthorizationCodeBearer": [
              "organization:create_api_key"
            ]
          }
        ],
        "summary": "Create Organization Api Key",
        "tags": [
          "API Keys"
        ]
      }
    },
    "/v1/api-keys/{api_key_id}/": {
      "delete": {
        "description": "Revoke (soft-delete) an API key. The key stops authenticating immediately.",
        "operationId": "revoke_organization_api_key_v1_api_keys__api_key_id___delete",
        "parameters": [
          {
            "in": "path",
            "name": "api_key_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Api Key Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "400": {
            "description": "Cannot retire a token belonging to a frontend application"
          },
          "404": {
            "description": "API key not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPExceptionError"
                }
              }
            },
            "description": "Rate limit exceeded",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2AuthorizationCodeBearer": [
              "organization:write_api_key"
            ]
          }
        ],
        "summary": "Revoke Organization Api Key",
        "tags": [
          "API Keys"
        ]
      },
      "patch": {
        "description": "Update an API key's title, description, and/or per-scope `claims`.\n\nAn empty body is rejected with 422.",
        "operationId": "update_organization_api_key_v1_api_keys__api_key_id___patch",
        "parameters": [
          {
            "in": "path",
            "name": "api_key_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Api Key Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/APIKeyUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIKeyRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "API key not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPExceptionError"
                }
              }
            },
            "description": "Rate limit exceeded",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2AuthorizationCodeBearer": [
              "organization:write_api_key"
            ]
          }
        ],
        "summary": "Update Organization Api Key",
        "tags": [
          "API Keys"
        ]
      }
    }
  },
  "servers": [
